---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SideNav from '../../../components/SideNav.astro';
import { manualUrl, DEFAULT_LANG, type Lang } from '../../../i18n';
import { manualPage as copy } from '../../../content/site-copy';

export async function getStaticPaths() {
  const all = await getCollection('manual');
  const paths = [];

  for (const lang of ['zh', 'en'] as const) {
    const entries = all.filter((e) => e.data.lang === lang).sort((a, b) => a.data.order - b.data.order);
    entries.forEach((entry, i) => {
      paths.push({
        // 默认语言（英文）不带前缀
        params: { lang: lang === 'en' ? undefined : lang, slug: entry.data.chapterSlug },
        props: {
          entry,
          prev: entries[i - 1] ?? null,
          next: entries[i + 1] ?? null,
        },
      });
    });
  }

  return paths;
}

interface Props {
  entry: CollectionEntry<'manual'>;
  prev: CollectionEntry<'manual'> | null;
  next: CollectionEntry<'manual'> | null;
}

const { entry, prev, next } = Astro.props;

const lang: Lang = Astro.params.lang === 'zh' ? 'zh' : DEFAULT_LANG;
const other: Lang = lang === 'zh' ? 'en' : 'zh';

const { Content, headings } = await render(entry);

const all = (await getCollection('manual', (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
const chapters = all.map((e) => ({
  href: manualUrl(lang, e.data.chapterSlug),
  label: e.data.title,
  note: e.data.chapter,
}));
const sections = headings.filter((h) => h.depth === 2);
---

<Base
  title={`${lang === 'zh' ? `第 ${entry.data.chapter} 章 ${entry.data.title}` : `Chapter ${entry.data.chapter} · ${entry.data.title}`} — openheron`}
  description={`openheron ${lang === 'zh' ? '用户手册' : 'user manual'} · ${entry.data.title}`}
  lang={lang}
  alternatePath={manualUrl(other, entry.data.chapterSlug)}
>
  <div class="container manual-shell">
    <SideNav
      items={chapters}
      currentHref={manualUrl(lang, entry.data.chapterSlug)}
      sections={sections}
      back={{ href: manualUrl(lang), label: copy.backToManual[lang] }}
      listLabel={copy.toc[lang]}
      sectionsLabel={copy.sections[lang]}
    />

    <article class="manual-body">
      <header class="manual-head">
        <span class="eyebrow">
          {lang === 'zh' ? `第 ${entry.data.chapter} 章` : `Chapter ${entry.data.chapter}`}
        </span>
        <h1>{entry.data.title}</h1>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label={lang === 'zh' ? '章节导航' : 'Chapter navigation'}>
        {
          prev ? (
            <a href={manualUrl(lang, prev.data.chapterSlug)} class="pager__link pager__link--prev">
              <span class="pager__dir">← {copy.prev[lang]}</span>
              <span class="pager__title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={manualUrl(lang, next.data.chapterSlug)} class="pager__link pager__link--next">
              <span class="pager__dir">{copy.next[lang]} →</span>
              <span class="pager__title">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </div>
</Base>

<style>
  .manual-shell {
    display: flex;
    gap: 56px;
    align-items: flex-start;
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .manual-body {
    flex: 1 1 auto;
    min-width: 0;
    /* 窄屏切成 column + align-items:flex-start 后，不写宽度会让这一栏按内容宽度
       取满 max-width —— 只有代码块且代码行很长的章节（命令行速查）就会把整页撑宽。 */
    width: 100%;
    max-width: 780px;
  }

  .manual-head {
    padding-bottom: 26px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .manual-head h1 {
    font-size: clamp(28px, 3.6vw, 40px);
    margin-bottom: 4px;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .pager__link {
    display: grid;
    gap: 4px;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.18s ease, transform 0.18s ease;
    max-width: 46%;
  }

  .pager__link:hover {
    border-color: var(--accent-line);
    transform: translateY(-1px);
  }

  .pager__link--next {
    text-align: right;
  }

  .pager__dir {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-faint);
  }

  .pager__title {
    font-size: 15px;
    color: var(--text);
  }

  @media (max-width: 1000px) {
    .manual-shell {
      flex-direction: column;
      gap: 32px;
    }
  }
</style>

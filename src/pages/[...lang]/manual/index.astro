---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { manualUrl, homeUrl, DEFAULT_LANG, type Lang } from '../../../i18n';
import { manualPage as copy } from '../../../content/site-copy';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'zh' } },
  ];
}

const lang: Lang = Astro.params.lang === 'zh' ? 'zh' : DEFAULT_LANG;
const other: Lang = lang === 'zh' ? 'en' : 'zh';

const entries = (await getCollection('manual', (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);

// 每章的小节标题：渲染一次拿 headings，页面上直接链到对应锚点。
const chapters = await Promise.all(
  entries.map(async (entry) => {
    const { headings } = await render(entry);
    return {
      slug: entry.data.chapterSlug,
      title: entry.data.title,
      chapter: entry.data.chapter,
      sections: headings.filter((h) => h.depth === 2),
    };
  }),
);
---

<Base
  title={`${copy.title[lang]} — openheron`}
  description={copy.lead[lang]}
  lang={lang}
  alternatePath={manualUrl(other)}
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">{copy.eyebrow[lang]}</span>
      <h1>{copy.title[lang]}</h1>
      <p>{copy.lead[lang]}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="chapter-grid">
        {
          chapters.map((c) => (
            <article class="chapter-card" data-enter="flip">
              <a href={manualUrl(lang, c.slug)} class="chapter-card__link">
                <span class="chapter-card__no">{c.chapter}</span>
                <h2 class="chapter-card__title">{c.title}</h2>
              </a>
              <ul class="chapter-card__sections">
                {c.sections.map((s) => (
                  <li>
                    <a href={`${manualUrl(lang, c.slug)}#${s.slug}`}>{s.text}</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <p class="source-note" data-enter="rise">{copy.note[lang]}</p>
    </div>
  </section>
</Base>

<style>
  .chapter-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    align-items: start;
  }

  .chapter-card {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 24px 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .chapter-card:hover {
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }

  .chapter-card__link {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .chapter-card__no {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
    min-width: 20px;
  }

  .chapter-card__title {
    font-size: 19px;
  }

  .chapter-card__sections {
    display: grid;
    gap: 5px;
    padding-left: 32px;
  }

  .chapter-card__sections a {
    font-size: 13.5px;
    color: var(--text-faint);
    line-height: 1.5;
  }

  .chapter-card__sections a:hover {
    color: var(--accent);
  }

  .source-note {
    margin-top: 28px;
    font-size: 13.5px;
    color: var(--text-faint);
  }

  .source-note code {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .chapter-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
// 架构示意简图：概念层级，不含实现细节。
// 分层依据 openheron 的架构文档 —— 浏览器 → 接口层 → 编排运行时 → agent → 工具，
// 事件再沿 AG-UI 流回到浏览器。
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const zh = lang === 'zh';

const layers = [
  {
    label: zh ? '你' : 'You',
    desc: zh ? '浏览器里对话 · 审批 · 传附件' : 'Chat, approve and attach in the browser',
    mod: 'you',
  },
  {
    label: zh ? '接口层' : 'Interface layer',
    desc: zh ? 'HTTP 接口 · AG-UI 事件流回传' : 'HTTP interface · AG-UI events streamed back',
  },
  {
    label: zh ? '运行时' : 'Runtime',
    desc: zh ? '多轮常驻 · 单轮准入 · 从断点恢复' : 'Multi-turn, one turn at a time, resumable from checkpoints',
    mod: 'key',
  },
  {
    label: 'agent',
    desc: zh ? '模型 · 工具 · 技能 · MCP · 子 agent' : 'Model · tools · skills · MCP · sub agents',
    mod: 'key',
  },
];

const links = [
  zh ? '请求' : 'Request',
  zh ? '编排' : 'Orchestrate',
  zh ? '装配' : 'Assemble',
  zh ? '调用' : 'Call',
];

const tools = [
  {
    icon: '◔',
    name: zh ? '读代码' : 'Read code',
    desc: zh ? '检索、追调用链' : 'Search, trace call chains',
  },
  {
    icon: '✎',
    name: zh ? '改文件 · 执行命令' : 'Edit files · run commands',
    desc: zh ? '破坏性动作 · 尤其要点头' : 'Destructive · especially needs your nod',
    gate: true,
  },
  {
    icon: '⇄',
    name: zh ? '委派子 agent' : 'Delegate to sub agents',
    desc: zh ? '并行或串行' : 'In parallel or in series',
  },
  {
    icon: '⌕',
    name: zh ? '检索知识库' : 'Search the knowledge base',
    desc: zh ? '先给大纲，要哪段再读' : 'An outline first, then read the part you need',
  },
  {
    icon: '⊕',
    name: zh ? 'MCP 服务器' : 'MCP servers',
    desc: zh ? '挂一个，拿到它全部工具' : 'Mount one, get all its tools',
  },
  {
    icon: '⚙',
    name: zh ? '配置工具' : 'Config tools',
    desc: zh ? '读改自己的配置 · 写要点头' : 'Reads or rewrites its own config',
  },
];
---

<div class="arch" data-enter="flip">
  <div class="arch__stack">
    <div class="arch__row">
      <div class="arch__box arch__box--you">
        <span class="arch__label">{layers[0].label}</span>
        <span class="arch__desc">{layers[0].desc}</span>
      </div>
    </div>

    <div class="arch__link"><span class="arch__link-text">{links[0]}</span></div>

    <div class="arch__row">
      <div class="arch__box">
        <span class="arch__label">{layers[1].label}</span>
        <span class="arch__desc">{layers[1].desc}</span>
      </div>
    </div>

    <div class="arch__link"><span class="arch__link-text">{links[1]}</span></div>

    <div class="arch__row">
      <div class="arch__box arch__box--key">
        <span class="arch__label">{layers[2].label}</span>
        <span class="arch__desc">{layers[2].desc}</span>
      </div>
    </div>

    <div class="arch__link"><span class="arch__link-text">{links[2]}</span></div>

    <div class="arch__row">
      <div class="arch__box arch__box--key">
        <span class="arch__label">{layers[3].label}</span>
        <span class="arch__desc">{layers[3].desc}</span>
      </div>
    </div>

    <div class="arch__link"><span class="arch__link-text">{links[3]}</span></div>

    <div class="arch__row arch__row--tools">
      {
        tools.map((tool) => (
          <div class:list={['arch__tool', { 'arch__tool--gate': tool.gate }]}>
            <span class="arch__tool-icon" aria-hidden="true">{tool.icon}</span>
            <span class="arch__tool-name">{tool.name}</span>
            <span class="arch__tool-desc">{tool.desc}</span>
          </div>
        ))
      }
    </div>

    <div class="arch__link arch__link--back">
      <span class="arch__link-text">{zh ? '事件流回到浏览器' : 'Event stream back to the browser'}</span>
    </div>
  </div>

  <div class="arch__note">
    <span class="arch__note-badge">{zh ? '默认都要点头' : 'Your nod by default'}</span>
    <span class="arch__note-text">
      {
        zh
          ? '没人点名的工具一律先问：这一轮当场停住，界面弹出审批卡。只有工具文件里点名放行的才免问 —— 改文件、执行命令这类破坏性动作自然不在其中。你批准，它从断点继续；你拒绝，理由写不写都行，写了会回灌给它让它换条路走。'
          : 'Every tool nobody named is asked about first: the turn stops on the spot and an approval card appears. Only tools a file exempts run unasked — and editing files or running commands are certainly not among them. Approve and it resumes from the checkpoint; reject with or without a reason, and a reason is sent back so the agent can take another route.'
      }
    </span>
  </div>
</div>

<style>
  .arch {
    display: grid;
    gap: 18px;
  }

  .arch__stack {
    display: grid;
    gap: 0;
    max-width: 860px;
    margin-inline: auto;
  }

  .arch__row {
    display: grid;
    place-items: center;
  }

  .arch__box {
    display: grid;
    gap: 5px;
    justify-items: center;
    width: min(100%, 440px);
    padding: 16px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-align: center;
  }

  .arch__box--you {
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .arch__box--key {
    border-color: var(--accent-line);
  }

  .arch__label {
    font-family: var(--font-mono);
    font-size: 14.5px;
    color: var(--text);
  }

  .arch__desc {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* 竖线在文字处断开，不做遮罩 —— 背景有光晕，遮罩会露馅 */
  .arch__link {
    position: relative;
    display: grid;
    place-items: center;
    height: 48px;
  }

  .arch__link::before,
  .arch__link::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    background: var(--border-strong);
  }

  .arch__link::before {
    top: 0;
    height: 13px;
  }

  .arch__link::after {
    bottom: 8px;
    height: 15px;
  }

  .arch__link-text {
    position: relative;
    padding: 0 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-faint);
  }

  /* 箭头 */
  .arch__link-text::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -14px;
    width: 7px;
    height: 7px;
    margin-left: -3px;
    border-right: 1px solid var(--accent);
    border-bottom: 1px solid var(--accent);
    transform: rotate(45deg);
  }

  /* 回流那条：箭头朝上 */
  .arch__link--back::before {
    top: 8px;
    height: 15px;
  }

  .arch__link--back::after {
    bottom: 0;
    height: 13px;
  }

  .arch__link--back .arch__link-text::after {
    bottom: auto;
    top: -14px;
    transform: rotate(225deg);
  }

  .arch__row--tools {
    display: grid;
    /* 六张工具卡排两行三列 —— 卡片更宽，描述里的长句才不至于挤成一条 */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 2px;
    /* 同一排等宽等高、顶部对齐：.arch__row 的 place-items:center 会让
       高度不同的卡片各自居中，一排卡片就参差了 */
    align-items: stretch;
    justify-items: stretch;
  }

  .arch__tool {
    display: grid;
    gap: 4px;
    justify-items: center;
    /* 卡片被拉高后，内容仍居中，不要散开 */
    align-content: center;
    text-align: center;
    padding: 16px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .arch__tool--gate {
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .arch__tool-icon {
    font-size: 17px;
    color: var(--accent);
    line-height: 1;
  }

  .arch__tool-name {
    font-size: 14px;
    color: var(--text);
  }

  .arch__tool-desc {
    font-size: 12px;
    color: var(--text-faint);
  }

  .arch__note {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    max-width: 860px;
    margin-inline: auto;
    padding: 16px 20px;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .arch__note-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    white-space: nowrap;
  }

  .arch__note-text {
    font-size: 14px;
    color: var(--text-muted);
    flex: 1 1 320px;
  }

  @media (max-width: 760px) {
    .arch__row--tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

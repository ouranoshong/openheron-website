---
import BrandMark from './BrandMark.astro';
import { manualUrl, type Lang } from '../i18n';
import { footer as copy } from '../content/site-copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const year = new Date().getFullYear();

const groups = [
  {
    title: copy.manualGroup[lang],
    links: [
      { href: manualUrl(lang), label: lang === 'zh' ? '用户手册' : 'User manual' },
      { href: manualUrl(lang, 'first-run'), label: lang === 'zh' ? '第一次使用' : 'First run' },
      { href: manualUrl(lang, 'interface'), label: lang === 'zh' ? '界面使用' : 'Using the interface' },
    ],
  },
  {
    title: copy.referenceGroup[lang],
    links: [
      { href: manualUrl(lang, 'configuration'), label: lang === 'zh' ? '配置怎么写' : 'Writing configuration' },
      { href: manualUrl(lang, 'multi-agent'), label: lang === 'zh' ? '多 Agent 与委派' : 'Multiple agents' },
      { href: manualUrl(lang, 'commands'), label: lang === 'zh' ? '命令行速查' : 'Command-line reference' },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <div class="footer__logo">
        <BrandMark size={20} uid="foot" />
        <span>openheron</span>
      </div>
      <p class="faint">
        {copy.tagline[lang]}<br />
        {copy.motto[lang]}
      </p>
    </div>

    {
      groups.map((group) => (
        <div class="footer__col">
          <h4>{group.title}</h4>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="footer__col">
      <h4>{lang === 'zh' ? '技术栈' : 'Stack'}</h4>
      <ul class="footer__tags">
        <li><span class="badge badge--brand">Go 1.27</span></li>
        <li><span class="badge badge--cyan">SSE</span></li>
        <li><span class="badge">React</span></li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span class="faint">© {year} openheron</span>
    <span class="faint">
      {lang === 'zh' ? '内容依据 openheron 用户手册整理' : 'Content curated from the openheron user manual'}
    </span>
    <a class="footer__contact" href="mailto:ouranoshong@outlook.com">
      <span class="footer__contact-label">{lang === 'zh' ? '联系' : 'Contact'}</span>
      <span>ouranoshong@outlook.com</span>
    </a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: clamp(44px, 6vw, 72px) 0 28px;
    background: linear-gradient(180deg, transparent, rgba(126, 20, 255, 0.05));
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
    padding-bottom: 40px;
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 17px;
    margin-bottom: 14px;
  }

  .footer__brand p {
    font-size: 14px;
    line-height: 1.8;
  }

  .footer__col h4 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    margin-bottom: 16px;
    font-weight: 600;
  }

  .footer__col ul {
    display: grid;
    gap: 10px;
  }

  .footer__col a {
    font-size: 14.5px;
    color: var(--text-muted);
    transition: color 0.16s ease;
  }

  .footer__col a:hover {
    color: var(--accent);
  }

  .footer__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    flex-wrap: wrap;
  }

  .footer__contact {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    margin-left: auto;
    color: var(--text-muted);
    transition: color 0.16s ease;
  }

  .footer__contact:hover {
    color: var(--accent);
  }

  .footer__contact-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-family: var(--font-mono);
  }

  .footer__contact:hover .footer__contact-label {
    color: var(--text-faint);
  }

  @media (max-width: 880px) {
    .footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }

    .footer__contact {
      margin-left: 0;
    }
  }

  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

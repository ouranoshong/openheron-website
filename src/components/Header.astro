---
import BrandMark from './BrandMark.astro';
import LangSwitch from './LangSwitch.astro';
import { homeUrl, manualUrl, type Lang } from '../i18n';
import { nav as copy } from '../content/site-copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const nav = [
  { href: homeUrl(lang), label: copy.home[lang] },
  { href: manualUrl(lang), label: copy.manual[lang] },
  { href: manualUrl(lang, 'commands'), label: copy.commands[lang] },
];

/** 仓库地址：指向运行时本体，不是本站 */
const REPO_URL = 'https://github.com/ouranoshong/openheron';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`);
---

<header class="header">
  <div class="container header__inner">
    <a href={homeUrl(lang)} class="brand" aria-label="openheron">
      <span class="brand__mark" aria-hidden="true">
        <BrandMark size={28} uid="head" />
      </span>
      <span class="brand__name">openheron</span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      {
        nav.map((item) => (
          <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
      <a
        href={REPO_URL}
        class="nav__link nav__link--external"
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.github[lang]}
        <span class="nav__ext" aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="header__actions">
      <LangSwitch lang={lang} pathname={Astro.url.pathname} />
      <a class="btn btn--primary btn--sm" href={manualUrl(lang, 'first-run')}>{copy.quickstart[lang]}</a>
    </div>

    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" hidden>
    {
      nav.map((item) => (
        <a href={item.href} class:list={['mobile-nav__link', { 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))
    }
    <a
      href={REPO_URL}
      class="mobile-nav__link mobile-nav__link--external"
      target="_blank"
      rel="noopener noreferrer"
    >
      {copy.github[lang]}
      <span class="nav__ext" aria-hidden="true">↗</span>
    </a>
    <LangSwitch lang={lang} pathname={Astro.url.pathname} />
    <a class="btn btn--primary" href={manualUrl(lang, 'first-run')}>{copy.quickstart[lang]}</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    backdrop-filter: blur(14px);
    background: rgba(4, 3, 25, 0.78);
  }

  /* 参考主题的招牌细节：分隔线从内容左边缘一直延伸到屏幕右边缘 */
  .header::after {
    content: '';
    position: absolute;
    left: max(24px, calc((100% - var(--container)) / 2));
    right: 0;
    bottom: 0;
    height: 1px;
    background: var(--border);
  }

  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    filter: drop-shadow(0 0 14px rgba(220, 253, 53, 0.3));
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-right: auto;
  }

  .nav__link {
    padding: 7px 13px;
    border-radius: 999px;
    font-size: 14.5px;
    color: var(--text-muted);
    transition: color 0.16s ease, background 0.16s ease;
  }

  .nav__link:hover {
    color: var(--accent);
  }

  .nav__link.is-active {
    color: var(--accent);
  }

  /* 外链：标签后跟一个 ↗，点开新标签页 */
  .nav__link--external {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .nav__ext {
    font-size: 11px;
    line-height: 1;
    color: var(--text-faint);
    transition: color 0.16s ease, transform 0.16s ease;
  }

  .nav__link--external:hover .nav__ext {
    color: var(--accent);
    transform: translate(1px, -1px);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-toggle {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    cursor: pointer;
    padding: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }

  .nav-toggle span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 20px 20px;
    border-bottom: 1px solid var(--border);
    background: rgba(4, 3, 25, 0.97);
  }

  .mobile-nav__link {
    padding: 11px 12px;
    border-radius: 10px;
    color: var(--text-muted);
  }

  .mobile-nav__link.is-active {
    color: var(--accent);
  }

  .mobile-nav__link--external {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  @media (max-width: 880px) {
    .nav {
      display: none;
    }

    .nav-toggle {
      display: flex;
      margin-left: auto;
    }

    .header__actions {
      margin-left: auto;
    }

    .mobile-nav {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.querySelector<HTMLElement>('.mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden') ?? true;
    if (open) menu?.removeAttribute('hidden');
    else menu?.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
